# Google Calendar (OAuth desktop flow)
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_SECRET=
VITE_GOOGLE_REFRESH_TOKEN=
VITE_GOOGLE_CALENDAR_ID=

# OneBusAway (Puget Sound)
VITE_OBA_API_KEY=
VITE_OBA_STOP_ID=
# Comma-separated list of OBA route IDs to include (e.g. 1_100224,1_100233)
VITE_OBA_ROUTE_IDS=
# Optional label shown on the bus card, e.g. "3rd & Pike"
VITE_OBA_DESTINATION_LABEL=

# Open-Meteo (no key needed) — override lat/lng if desired
VITE_WEATHER_LAT=47.6062
VITE_WEATHER_LNG=-122.3321
VITE_WEATHER_LABEL=Seattle
